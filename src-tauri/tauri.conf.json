{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wave Terminal",
  "version": "0.1.0",
  "identifier": "com.waveainetworks.wave-terminal",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "sh ../scripts/bundle-prep.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wave Terminal — CYSJavis Terminal",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/cysd",
      "binaries/cys"
    ],
    "resources": {
      "resources/pack.tar.gz": "./",
      "resources/pack-manifest.json": "./",
      "runtime/": "runtime/"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgMDJCRTE3RUI2RUI4MDRBMQpSV1NoQkxodTZ4ZStBbnpkTGhPS1V1WHlaYjZGUGp1QlNXRzBzN1NQYWN5M3Y5bzRRdDhZOW1xSQo=",
      "endpoints": [
        "https://github.com/greatson79/wave-terminal/releases/download/v0.1.0/latest.json"
      ]
    }
  }
}
