{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wave Terminal",
  "mainBinaryName": "wave-app",
  "version": "0.3.7",
  "identifier": "com.waveainetworks.wave-terminal",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "sh ../scripts/bundle-prep.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wave Terminal",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/wave",
      "binaries/waved",
      "binaries/cys",
      "binaries/cysd",
      "binaries/cys-app"
    ],
    "resources": {
      "resources/pack.tar.gz": "./",
      "resources/pack-manifest.json": "./",
      "runtime/": "runtime/"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyNUYxRjg0MTU3RDdEQkYKUldTL2ZYMFZoQjlmUWtBS3Y2UUc4enF0WVVrRFRxbmFKRXQrOVhaKy9oQSt4K21PakM1SDdQV1IK",
      "endpoints": [
        "https://github.com/greatson79/wave-terminal/releases/latest/download/latest.json"
      ]
    }
  }
}
